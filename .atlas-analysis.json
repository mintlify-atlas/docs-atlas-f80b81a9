  "keyFeatures": [
    "Disassemble Hermes bytecode files (v61-v96)",
    "Extract function fingerprints with structural and content hashing",
    "Detect vulnerable npm packages in React Native apps",
    "Fuzzy matching with Levenshtein distance",
    "MongoDB-based fingerprint database",
    "Parallel pipeline processing across React Native versions",
    "Support for iOS IPA and HBC file analysis",
    "Automatic opcode generation from Hermes source"
  ],
  "publicApiSurface": [
    "disassemble - Disassemble HBC files to human-readable output",
    "analyze - Analyze IPA/HBC files for vulnerable packages",
    "maintain-database - Build and update fingerprint database",
    "genopcodes - Generate Go opcode definitions from Hermes source",
    "packages - Package management utilities"
  ]
